func Test{{.ProviderTitle}}_{{.FromVersion}}_to_{{.ToVersion}}_Detection(t *testing.T) {
	testCases := []struct {
		name                string
		configDir          string
		rulesFile          string
		expectedFindings   int
		expectedRuleIDs    []string
	}{
		{
			name:             "basic_upgrade",
			configDir:        "testdata/terraform/providers/{{.Provider}}/{{.FromVersion}}_to_{{.ToVersion}}",
			rulesFile:        "testdata/rules/{{.Provider}}/{{.FromVersion}}_to_{{.ToVersion}}.jsonl",
			expectedFindings: {{.ExpectedBasicFindings}},
			expectedRuleIDs: []string{
				"{{.RulePrefix}}.provider.{{.FromVersion}}_to_{{.ToVersion}}.min_version.001",
				{{- range .ExpectedRuleIDs}}
				"{{.}}",
				{{- end}}
			},
		},
		{{- if .HasComplexScenario}}
		{
			name:             "complex_scenario",
			configDir:        "testdata/terraform/providers/{{.Provider}}/{{.FromVersion}}_to_{{.ToVersion}}/complex",
			rulesFile:        "testdata/rules/{{.Provider}}/comprehensive.jsonl",
			expectedFindings: {{.ExpectedComplexFindings}},
			expectedRuleIDs: []string{
				{{- range .ExpectedComplexRuleIDs}}
				"{{.}}",
				{{- end}}
			},
		},
		{{- end}}
	}

	for _, tc := range testCases {
		t.Run(tc.name, func(t *testing.T) {
			// Load rules pack
			rules, err := rules.LoadFromFile(tc.rulesFile)
			require.NoError(t, err)
			assert.NotEmpty(t, rules, "Rules pack should not be empty")

			// Parse Terraform configuration
			graph, err := hclparse.ParseDir(tc.configDir)
			require.NoError(t, err)
			assert.NotEmpty(t, graph.Providers, "Should detect providers")

			// Run rule matching
			findings := Match(graph, rules)

			// Verify findings count
			assert.Len(t, findings, tc.expectedFindings, "Unexpected number of findings")

			// Verify specific rule IDs are present
			actualRuleIDs := make([]string, len(findings))
			for i, f := range findings {
				actualRuleIDs[i] = f.RuleID
			}

			for _, expectedID := range tc.expectedRuleIDs {
				assert.Contains(t, actualRuleIDs, expectedID, "Expected rule ID not found: %s", expectedID)
			}

			// Verify findings have required fields
			for _, finding := range findings {
				assert.NotEmpty(t, finding.RuleID, "Finding should have rule ID")
				assert.NotEmpty(t, finding.RuleType, "Finding should have rule type")
				assert.NotEmpty(t, finding.Severity, "Finding should have severity")
				assert.NotEmpty(t, finding.File, "Finding should have file")
				assert.Greater(t, finding.Line, 0, "Finding should have line number")
				assert.NotEmpty(t, finding.Message, "Finding should have message")
			}
		})
	}
}

