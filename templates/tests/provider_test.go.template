func Test{{.ProviderTitle}}_{{.FromVersion}}_to_{{.ToVersion}}_Codemods(t *testing.T) {
	{{- if .HasCodemods}}
	testCases := []struct {
		name         string
		configDir    string
		rulesFile    string
		expectedDiff string
	}{
		{{- range .CodemodTests}}
		{
			name:         "{{.Name}}",
			configDir:    "testdata/terraform/providers/{{$.Provider}}/{{.ConfigDir}}",
			rulesFile:    "testdata/rules/{{$.Provider}}/{{.RulesFile}}",
			expectedDiff: "testdata/golden/providers/{{$.Provider}}/patches/{{.ExpectedDiff}}",
		},
		{{- end}}
	}

	for _, tc := range testCases {
		t.Run(tc.name, func(t *testing.T) {
			// Load rules and generate fixes
			rules, err := rules.LoadFromFile(tc.rulesFile)
			require.NoError(t, err)

			graph, err := hclparse.ParseDir(tc.configDir)
			require.NoError(t, err)

			findings := Match(graph, rules)

			// Filter findings that have fix codemods
			var fixableFindings []Finding
			for _, f := range findings {
				if f.Fix != nil {
					fixableFindings = append(fixableFindings, f)
				}
			}

			assert.NotEmpty(t, fixableFindings, "Should have findings with fixes")

			// Apply codemods and generate diffs
			results, err := codemod.Apply(tc.configDir, fixableFindings)
			require.NoError(t, err, "Codemod application should not error")
			assert.NotEmpty(t, results, "Should generate at least one diff")

			// Verify each result has valid diff content
			for _, result := range results {
				assert.NotEmpty(t, result.File, "Result should have file path")
				assert.NotEmpty(t, result.Diff, "Result should have non-empty diff")

				// Verify diff format (should contain unified diff headers)
				assert.Contains(t, result.Diff, "--- a/", "Diff should contain original file marker")
				assert.Contains(t, result.Diff, "+++ b/", "Diff should contain modified file marker")

				// Verify diff has actual changes (should have + or - lines)
				hasChanges := strings.Contains(result.Diff, "\n+") || strings.Contains(result.Diff, "\n-")
				assert.True(t, hasChanges, "Diff should contain actual line changes")
			}

			// If golden diff file exists, compare against it
			if tc.expectedDiff != "" {
				goldenData, err := os.ReadFile(tc.expectedDiff)
				if err == nil {
					// Golden file exists, verify we have matching results
					goldenDiff := string(goldenData)

					// Check that at least one result matches the golden diff pattern
					// or contains the key changes from the golden file
					foundMatch := false
					for _, result := range results {
						if strings.Contains(result.Diff, goldenDiff) ||
						   strings.Contains(goldenDiff, filepath.Base(result.File)) {
							foundMatch = true
							break
						}
					}

					if !foundMatch {
						t.Logf("Generated diffs do not match expected golden file: %s", tc.expectedDiff)
						t.Logf("Generated %d diff(s):", len(results))
						for i, r := range results {
							t.Logf("  [%d] %s:\n%s", i, r.File, r.Diff)
						}
					}
				}
				// If golden file doesn't exist yet, that's OK - it's a future enhancement
			}
		})
	}
	{{- else}}
	t.Skip("No codemods defined for {{.Provider}} {{.FromVersion}} to {{.ToVersion}}")
	{{- end}}
}

func Test{{.ProviderTitle}}_{{.FromVersion}}_to_{{.ToVersion}}_StateOperations(t *testing.T) {
	{{- if .HasStateOps}}
	testCases := []struct {
		name            string
		configDir       string
		rulesFile       string
		expectedStateOps []StateOp
	}{
		{{- range .StateOpTests}}
		{
			name:      "{{.Name}}",
			configDir: "testdata/terraform/providers/{{$.Provider}}/{{.ConfigDir}}",
			rulesFile: "testdata/rules/{{$.Provider}}/{{.RulesFile}}",
			expectedStateOps: []StateOp{
				{{- range .ExpectedOps}}
				{Op: "{{.Op}}", Addr: "{{.Addr}}"{{if .Dest}}, Dest: "{{.Dest}}"{{end}}},
				{{- end}}
			},
		},
		{{- end}}
	}

	for _, tc := range testCases {
		t.Run(tc.name, func(t *testing.T) {
			rules, err := rules.LoadFromFile(tc.rulesFile)
			require.NoError(t, err)

			graph, err := hclparse.ParseDir(tc.configDir)
			require.NoError(t, err)

			findings := Match(graph, rules)

			// Collect all state operations from findings
			var allStateOps []StateOp
			for _, f := range findings {
				if len(f.State) > 0 {
					allStateOps = append(allStateOps, f.State...)
				}
			}

			// Verify expected state operations
			for _, expectedOp := range tc.expectedStateOps {
				found := false
				for _, actualOp := range allStateOps {
					if actualOp.Op == expectedOp.Op && actualOp.Addr == expectedOp.Addr {
						if expectedOp.Dest == "" || actualOp.Dest == expectedOp.Dest {
							found = true
							break
						}
					}
				}
				assert.True(t, found, "Expected state operation not found: %+v", expectedOp)
			}
		})
	}
	{{- else}}
	t.Skip("No state operations defined for {{.Provider}} {{.FromVersion}} to {{.ToVersion}}")
	{{- end}}
}

func Test{{.ProviderTitle}}_{{.FromVersion}}_to_{{.ToVersion}}_Performance(t *testing.T) {
	if testing.Short() {
		t.Skip("Skipping performance test in short mode")
	}

	// Load comprehensive rules pack
	rules, err := rules.LoadFromFile("testdata/rules/{{.Provider}}/comprehensive.jsonl")
	require.NoError(t, err)

	// Parse a complex configuration
	graph, err := hclparse.ParseDir("testdata/terraform/providers/{{.Provider}}/performance")
	require.NoError(t, err)

	// Benchmark the matching process
	startTime := time.Now()
	findings := Match(graph, rules)
	duration := time.Since(startTime)

	// Performance assertions
	assert.Less(t, duration, 5*time.Second, "Matching should complete within 5 seconds")
	assert.NotEmpty(t, findings, "Should produce findings")

	t.Logf("{{.ProviderTitle}} {{.FromVersion}}→{{.ToVersion}} performance: %d findings in %v", len(findings), duration)
}

